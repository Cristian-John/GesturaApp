<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/backgroundbg">

    <!-- 🔍 Search Bar -->
    <EditText
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search history..."
        android:drawableStart="@android:drawable/ic_menu_search"
        android:padding="12dp"
        android:background="@drawable/edittext_rounded"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <!-- 🔽 Filter Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <Spinner
            android:id="@+id/spinnerTypeFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/type_filter_options"
            android:spinnerMode="dropdown"
            android:padding="8dp"
            android:background="@android:drawable/btn_dropdown"
            android:dropDownWidth="match_parent" />

        <Spinner
            android:id="@+id/spinnerDateFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:entries="@array/date_filter_options"
            android:spinnerMode="dropdown"
            android:padding="8dp"
            android:background="@android:drawable/btn_dropdown"
            android:dropDownWidth="match_parent" />
    </LinearLayout>

    <!-- 📜 Empty Text -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No quiz or replication history yet."
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:visibility="gone"
        android:padding="16dp" />

    <!-- 🧾 History List -->
    <ListView
        android:id="@+id/listViewHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />
</LinearLayout>
